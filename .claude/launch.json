{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Next.js Dev Server",
      "runtimeExecutable": "node",
      "runtimeArgs": ["node_modules/next/dist/bin/next", "dev", "--turbopack"],
      "port": 3000
    },
    {
      "name": "Supabase Local (DB + Auth + Edge Functions)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["supabase", "start"],
      "port": 54321
    },
    {
      "name": "Supabase Studio (DB GUI)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["supabase", "studio"],
      "port": 54323
    }
  ]
}
