# =============================================================================
# BharatGrowth — Environment Variables
# Copy this to .env.local and fill in your values
# =============================================================================

# Supabase (REQUIRED)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role (server-side only — NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL (for receipt QR codes)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Demo mode (optional) — when true, billing can use local mock data
NEXT_PUBLIC_DEMO_MODE=false

# Campaign cron (REQUIRED for Bring-Back campaigns)
# Sent by Vercel Cron as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=generate-a-long-random-string

# WhatsApp Business API (optional — simulation mode when unset)
# WHATSAPP_ACCESS_TOKEN=your-whatsapp-token
# WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# WhatsApp inbound webhook (required for opt-out handling in production)
# Verify token: any random string, must match the value entered in Meta App Dashboard
# App secret: Meta App Dashboard → App Settings → Basic → App Secret
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-verify-token
# WHATSAPP_APP_SECRET=your-meta-app-secret
