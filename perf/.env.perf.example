# =============================================================================
# BharatGrowth perf harness — LOCAL-ONLY config
# Copy to perf/.env.perf (gitignored) and fill with your LOCAL supabase values
# (printed by `supabase start`). The env-guard hard-aborts on any non-local host.
# =============================================================================

# Target must be the local supabase stack. Non-127.0.0.1 hosts are rejected.
PERF_TARGET_URL=http://127.0.0.1:54321

# Local supabase anon + service-role keys (from `supabase start` output).
# These are the well-known LOCAL demo keys — never paste hosted keys here.
PERF_SUPABASE_ANON_KEY=REPLACE_WITH_LOCAL_ANON_KEY
PERF_SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_LOCAL_SERVICE_ROLE_KEY

# Direct Postgres connection for the invariant checker (local supabase default).
PERF_DB_HOST=127.0.0.1
PERF_DB_PORT=54322
PERF_DB_NAME=postgres
PERF_DB_USER=postgres
PERF_DB_PASSWORD=postgres

# Unique tag for a seed/test run — every synthetic row is traceable to this,
# and cleanup deletes strictly by this id. Example: date +%Y%m%d-%H%M%S
PERF_RUN_ID=REPLACE_WITH_RUN_ID

# Password used for all seeded load users (so k6 can mint JWTs). Local only.
PERF_USER_PASSWORD=loadtest-pass-123

# Safety: must stay false. Any truthy value still cannot bypass the local host check.
ALLOW_NON_LOCAL=false
